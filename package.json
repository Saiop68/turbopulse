{
  "name": "turbopulse",
  "version": "1.0.4",
  "description": "Production-grade, zero-copy distributed rate limiting and job queue engine for Node.js powered by Rust & napi-rs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "napi": {
    "name": "turbopulse",
    "triples": {
      "defaults": true,
      "additional": []
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rate_limiter": {
      "import": "./dist/src_ts/rate_limiter.js",
      "types": "./dist/src_ts/rate_limiter.d.ts",
      "default": "./dist/src_ts/rate_limiter.js"
    },
    "./distributed_queue": {
      "import": "./dist/src_ts/distributed_queue.js",
      "types": "./dist/src_ts/distributed_queue.d.ts",
      "default": "./dist/src_ts/distributed_queue.js"
    }
  },
  "scripts": {
    "build:rust": "napi build --platform --release",
    "build:rust:debug": "napi build --platform",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "npm run build:rust && npm run build:ts",
    "test": "ts-node test/limiter.test.ts",
    "test:queue": "ts-node test/queue.test.ts",
    "test:limiter-dropin": "ts-node test/rate_limiter_dropin.test.ts",
    "test:queue-dropin": "ts-node test/queue_dropin.test.ts",
    "test:validation": "ts-node test/user_input_validation.test.ts",
    "test:cluster": "ts-node test/redis_cluster.test.ts",
    "test:all": "npm test && npm run test:queue && npm run test:limiter-dropin && npm run test:queue-dropin && npm run test:validation && npm run test:cluster",
    "benchmark": "ts-node test/benchmark.ts",
    "benchmark:redis": "ts-node test/benchmark_redis.ts",
    "benchmark:1m": "ts-node test/benchmark_1million.ts",
    "benchmark:1m-speed": "ts-node test/benchmark_1m_ops_per_sec.ts"
  },
  "keywords": [
    "rate-limiter",
    "queue",
    "job-queue",
    "napi-rs",
    "rust",
    "zero-copy",
    "distributed",
    "redis",
    "token-bucket",
    "sliding-window"
  ],
  "author": "TurboPulse Core Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saiop68/turbopulse.git"
  },
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "turbopulse.node",
    "turbopulse.*.node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.6",
    "ioredis": "^6.0.0",
    "redis": "^6.3.1",
    "ssh2": "^1.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
